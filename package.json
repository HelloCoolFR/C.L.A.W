{
  "name": "claw-companion",
  "productName": "C.L.A.W Companion",
  "version": "1.0.7",
  "main": "dist-electron/main.js",
  "description": "C.L.A.W Desktop Companion App",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json && node build-electron.js",
    "start": "electron .",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.3.0",
    "katex": "^0.18.4",
    "marked": "^18.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "build": {
    "appId": "com.claw.companion",
    "publish": {
      "provider": "github",
      "owner": "HelloCoolFR",
      "repo": "C.L.A.W",
      "private": true
    },
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "icon.png",
      "icon.ico",
      "tray-icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "include": "installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "uninstallDisplayName": "C.L.A.W Companion",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "C.L.A.W Companion",
      "runAfterFinish": true
    },
    "extraResources": [
      "icon.png",
      "icon.ico",
      "tray-icon.png"
    ]
  }
}
